# ==========================================================================
# FamilyHub — family wall-calendar app
# Copy to .env and fill in. Values marked (Phase N) are unused until that
# phase lands; leave them blank until then.
# ==========================================================================

# --- Application -----------------------------------------------------------
APP_NAME=FamilyHub
APP_ENV=local                      # local | production
APP_KEY=                           # php artisan key:generate
APP_DEBUG=true                     # MUST be false in production
APP_URL=http://familyhub.test      # production: https://hub.yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
FAMILYHUB_TIMEZONE=Europe/London   # display + day-boundary zone (storage is always UTC)

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- Logging ---------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single                   # production: daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                    # production: warning

# --- Database (MySQL) ------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=familyhub
DB_USERNAME=root
DB_PASSWORD=

# --- Redis / queues / cache ------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=database            # survives a Redis flush; wall display stays logged in
SESSION_LIFETIME=525600            # 1 year — the wall iPad must never be logged out
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=redis             # Horizon supervises this
CACHE_STORE=redis
BROADCAST_CONNECTION=log           # Phase 1: no realtime. Phase 2+: reverb

FILESYSTEM_DISK=local              # production: s3

# --- FamilyHub: household --------------------------------------------------
# Seeded by `php artisan familyhub:seed-demo` and the initial migration seed.
FAMILYHUB_HOUSEHOLD_NAME="Our Family"

# Login accounts (parents). Format: Name|email|password, multiple separated by ";"
# Passwords are hashed on seed. Change them after first login.
FAMILYHUB_SEED_USERS="Parent One|parent1@example.com|change-me-now"

# Family members (calendar owners, incl. children).
# Format: Name|#hexcolour|adult\child|pin   — pin only used for children.
# Multiple separated by ";". The pin gates reward redemptions (Phase 4).
FAMILYHUB_SEED_MEMBERS="Parent One|#2563eb|adult|;Parent Two|#db2777|adult|;Child One|#16a34a|child|1234"

# --- FamilyHub: wall display ----------------------------------------------
# /display?token=... — stored in localStorage so the iPad never sees a login.
# Generate with: php artisan familyhub:display-token
FAMILYHUB_DISPLAY_TOKEN=

# Dark mode schedule (24h, local time). Applied client-side on the wall display.
FAMILYHUB_DARK_START=21:00
FAMILYHUB_DARK_END=06:30

# Idle photo screensaver
FAMILYHUB_IDLE_MINUTES=10          # 0 disables the screensaver
FAMILYHUB_PHOTOS_DISK=public       # public | s3
FAMILYHUB_PHOTOS_PATH=photos       # folder within the disk
FAMILYHUB_PHOTO_INTERVAL=30        # seconds per photo

# --- Anthropic (capture / extraction) --------------------------------------
# Required for capture. Without it, captures are stored but never read.
ANTHROPIC_API_KEY=
# Extraction model. claude-opus-5 is the more capable option if a school's
# newsletters prove hard to read; claude-haiku-4-5 is cheaper and weaker.
ANTHROPIC_MODEL=claude-sonnet-5
# Thinking shares this budget with the answer, so it covers both.
ANTHROPIC_MAX_TOKENS=32000
# Extraction is transcription, not reasoning. low | medium | high | xhigh | max
ANTHROPIC_EFFORT=low

# --- Apple iCloud CalDAV ---------------------------------------------------
# Calendars are iCloud-only; Google is out of scope.
#
# NO CREDENTIALS GO HERE. Apple IDs and app-specific passwords are entered in
# /admin -> Calendars and stored encrypted, so several family Apple IDs can be
# connected at once. Only transport settings live in .env.
#
# App-specific password: appleid.apple.com -> Sign-In and Security ->
# App-Specific Passwords.
ICLOUD_CALDAV_URL=https://caldav.icloud.com
CALDAV_TIMEOUT=30
CALDAV_WINDOW_BACK=90              # days of history a full sync asks for
CALDAV_WINDOW_FORWARD=400          # days ahead a full sync asks for

# --- Postmark inbound email ------------------------------------------------
# Postmark signs nothing, so the webhook authenticates with this shared secret,
# given either in the URL or as the basic-auth password:
#   https://hub.yourdomain.com/webhooks/postmark/<POSTMARK_INBOUND_SECRET>
# Generate one with: php -r 'echo bin2hex(random_bytes(24));'
POSTMARK_TOKEN=
POSTMARK_INBOUND_SECRET=

# Only mail addressed to this is captured. The inbound stream receives anything
# sent to the domain, so without it a stray or spam message becomes a capture.
# A +tag still matches (ai+sandygate@... reaches ai@...).
# Leave blank to accept everything the stream receives.
FAMILYHUB_INBOUND_ADDRESS=ai@hub.yourdomain.com
MAIL_MAILER=log                    # production: postmark
MAIL_FROM_ADDRESS="hub@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Twilio / WhatsApp (Phase 3, stub, off by default) ---------------------
FAMILYHUB_WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- S3 (attachments, photos, DB backups) ----------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Home Assistant (Phase 6) ----------------------------------------------
# The only smart-home driver. Zigbee switches arrive via Zigbee2MQTT in HA;
# HA is also the bridge to the Alexa household.
# The address you already use for Home Assistant, port and all — or with no
# port, which is this install: it is behind a reverse proxy on 80, not on the
# 8123 everyone assumes. Nothing appends a port to this.
HA_URL=http://homeassistant.local
HA_TOKEN=                          # long-lived access token from your HA profile
HA_CACHE_SECONDS=5                 # how long a state read is shared before asking again

# --- Misc integrations (Phase 6) -------------------------------------------
WEATHER_LATITUDE=51.8
WEATHER_LONGITUDE=-0.8             # Open-Meteo, no API key needed
BIN_COLLECTION_URL=                # Buckinghamshire Council iCal / lookup URL
SCHOOL_TERM_ICS_URL=

# --- Error tracking (optional) ---------------------------------------------
SENTRY_LARAVEL_DSN=

VITE_APP_NAME="${APP_NAME}"
